{
  "name": "agente-ia-itsm-enterprise",
  "version": "0.1.8",
  "description": "Cliente de escritorio del Asistente ITSM Forum.",
  "author": "Geimser",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/supabase-js": "2.106.2",
    "lucide-react": "1.16.0",
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sip.js": "^0.21.2"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "4.3.0",
    "tsx": "4.20.5",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "cl.geimser.forumitsm",
    "productName": "Asistente ITSM Forum",
    "artifactName": "Asistente-ITSM-Forum-Setup-${version}.${ext}",
    "directories": {
      "app": "desktop",
      "output": "installer"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ],
    "protocols": [
      {
        "name": "Asistente ITSM Forum",
        "schemes": [
          "forumitsm"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
