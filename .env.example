NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sesión compartida con ITSM Geimser. Debe coincidir con el origen autorizado
# en GEIMSER_BOT_ORIGINS del ITSM.
TENANT_GEIMSER_HOSTS=iabot.geimser.cl
TENANT_FORUM_HOSTS=iabot.mda.demoitsm.cl

# Server-only. Do not expose in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional for direct schema administration.
POSTGRES_URL_NON_POOLING=

# ── Motor LLM primario: Anthropic (Claude) ────────────────────────────────────
# Recomendado. Habilita comprensión NLU real, tool calling y memoria conversacional.
# Obtener en: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Motor LLM secundario: Mercury/Inception ──────────────────────────────────
# Se usa si ANTHROPIC_API_KEY no está configurado.
MERCURY_API_KEY=
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-2

# Prioridad: Anthropic → Mercury → Mock (reglas deterministicas sin LLM)

# ── ITSM real: Zammad (ITSM Geimser) ─────────────────────────────────────────
# Con estas variables el bot crea/consulta tickets reales en el ITSM.
ITSM_PROVIDER=zammad
ZAMMAD_GEIMSER_BASE_URL=https://mda.demoitsm.cl
ZAMMAD_GEIMSER_API_TOKEN=
ZAMMAD_GEIMSER_GROUP=Users
# Legacy Geimser deployments using ZAMMAD_BASE_URL / ZAMMAD_API_TOKEN remain
# supported only for the geimser tenant during the migration.
ZAMMAD_FORUM_BASE_URL=https://mda.demoitsm.cl
ZAMMAD_FORUM_API_TOKEN=
ZAMMAD_FORUM_GROUP=Users
# URL completa entregada por Zammad en Sistema > Integraciones > CTI genérica.
# Contiene un token secreto: debe existir sólo en variables server-side.
ZAMMAD_FORUM_CTI_URL=

# Cada tenant usa un secreto HMAC distinto. La identidad del tenant también
# forma parte de la firma para impedir replay entre dominios.
TELEPHONY_GEIMSER_WEBHOOK_SECRET=
TELEPHONY_FORUM_WEBHOOK_SECRET=
TELEPHONY_FORUM_ALLOWED_DIDS=
TELEPHONY_FORUM_FALLBACK_EMAIL=telefono@atlas.local

# Softphone WebRTC embebido en la mesa de ayuda Forum. Todos los secretos son
# server-only: no usar prefijo NEXT_PUBLIC.
TELEPHONY_FORUM_AGENT_ACCESS_TOKEN=
TELEPHONY_FORUM_AGENT_SESSION_SECRET=
TELEPHONY_FORUM_AGENT_EMAILS=admin@atlas.local
NEXT_PUBLIC_TELEPHONY_FORUM_AGENT_EMAILS=admin@atlas.local
TELEPHONY_FORUM_SIP_EXTENSION=6020
TELEPHONY_FORUM_SIP_PASSWORD=
TELEPHONY_FORUM_SIP_DOMAIN=ws.demoitsm.cl
TELEPHONY_FORUM_SIP_WSS=wss://ws.demoitsm.cl:8089/ws
GEIMSER_CMDB_TOKEN=
FORUM_CMDB_TOKEN=
